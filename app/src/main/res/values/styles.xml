<resources>
    <!-- Base application theme. -->
    <style name="BaseTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/defaultBrand</item>
        <item name="colorAccent">@color/defaultBrand</item>
        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:windowLightStatusBar">@bool/isDayMode</item>
        <item name="toolbarNavigationButtonStyle">@style/Toolbar.Button.Navigation.Tinted</item>
    </style>

    <style name="AppTheme" parent="BaseTheme"/>

    <!--
      ~ Since Android 12 the system draws the splash screen itself, from these
      ~ three values, and a window background of our own is either ignored or
      ~ drawn on top of it. The compat library brings the same behaviour to
      ~ older versions.
      -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/defaultBrand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <!--
          ~ Saying there is an icon background pins down what the system does:
          ~ the icon gets a 240dp canvas with a 160dp circle visible, which is
          ~ the size splash_icon is drawn for. It is the same brand colour as
          ~ the screen behind it, so what shows is still a white logo on blue.
          -->
        <item name="windowSplashScreenIconBackgroundColor">@color/defaultBrand</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <style name="EditorTheme" parent="Theme.MaterialComponents.DayNight">
        <item name="colorPrimary">@color/defaultBrand</item>
        <item name="colorAccent">@color/defaultBrand</item>
        <item name="android:statusBarColor">@color/defaultNoteTint</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="toolbarNavigationButtonStyle">@style/Note.Toolbar.Button.Navigation.Tinted</item>
    </style>

    <style name="Toolbar.Button.Navigation.Tinted" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="android:tint">?colorOnBackground</item>
    </style>

    <style name="Note.Toolbar.Button.Navigation.Tinted" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="android:tint">@color/defaultNoteTint</item>
    </style>
</resources>